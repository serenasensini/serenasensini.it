# Variabili lette dallo script di build (scripts/build.mjs).
# In locale: copia questo file in .env. Su GitHub: Settings > Secrets and variables > Actions > Variables.

# ID di misurazione Google Analytics 4 (es. G-XXXXXXXXXX). Se vuoto, GA non viene mai caricato.
GA_MEASUREMENT_ID=

# URL pubblico del sito, senza slash finale. Usato per canonical, sitemap e Open Graph.
SITE_URL=https://serenasensini.it
